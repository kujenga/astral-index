# Astral Index — environment variables
# Copy to .env and fill in what you need. All are optional.

# LLM (Claude) — classification, summaries, eval judges
# https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Reddit scraping
# Create a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Twitter/X scraping via SocialData.tools
# https://socialdata.tools/app/api-keys
SOCIALDATA_API_KEY=

# Newsletter publishing via Buttondown
# https://buttondown.com/keys
BUTTONDOWN_API_KEY=

# --- Observability backend (pick one, or use auto-detection) ---
# Override: "auto" (default), "braintrust", "phoenix", or "noop"
# ASTRAL_OBSERVABILITY_BACKEND=auto

# Option A: Braintrust (hosted, free tier 1GB/14-day, Pro $249/mo)
# https://www.braintrust.dev/app/settings/api-keys
BRAINTRUST_API_KEY=
# Opt-in tracing (counts toward free-tier span limits)
# BRAINTRUST_TRACE=1

# Option B: Phoenix (open-source, self-hostable, unlimited)
# Start with: pip install arize-phoenix && phoenix serve
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
# PHOENIX_API_URL=http://localhost:6006
# PHOENIX_API_KEY=  # optional for self-hosted

# Cross-model LLM judges (Phoenix path — direct OpenAI)
# Falls back to Claude Haiku when not set
# OPENAI_API_KEY=
